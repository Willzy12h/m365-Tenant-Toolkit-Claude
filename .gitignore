# Build output
bin/
obj/
dist/
portable/
*.user
*.suo
.vs/
TestResults/

# Runtime data created by the toolkit itself (never commit tenant evidence)
data/
logs/
app/

# User-local SDK installed by BUILD-ME-FIRST.cmd
.dotnet/

# Local tooling
*.log
build/last-build.log
*.tmp

# Exported reports can contain client configuration and names
reports/
# ...but never the reporting source. On a case-insensitive filesystem the rule above also matches
# src/BDIT.TenantToolkit.Engine/Reports, which is how those six files were lost from this repository.
!src/**/Reports/
!src/**/Reports/*.cs
*.csv.zip

# Never commit a local settings file carrying real client IDs; the repository copy stays a template
config/toolkit.settings.local.json
standards/manifest.json
