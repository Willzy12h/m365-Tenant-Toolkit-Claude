<Application x:Class="BDIT.TenantToolkit.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:infra="clr-namespace:BDIT.TenantToolkit.App.Infrastructure"
             ShutdownMode="OnMainWindowClose">
  <Application.Resources>
    <ResourceDictionary>
      <SolidColorBrush x:Key="BgWindow" Color="#F3F6FA"/>
      <SolidColorBrush x:Key="BgNav" Color="#10253B"/>
      <SolidColorBrush x:Key="BgNavHeader" Color="#0B1B2C"/>
      <SolidColorBrush x:Key="BgContent" Color="#FFFFFF"/>
      <SolidColorBrush x:Key="BgPanel" Color="#F7F9FC"/>
      <SolidColorBrush x:Key="Accent" Color="#1769AA"/>
      <SolidColorBrush x:Key="Danger" Color="#B3261E"/>
      <SolidColorBrush x:Key="DangerBg" Color="#FDE7E5"/>
      <SolidColorBrush x:Key="WarnBg" Color="#FFF5DE"/>
      <SolidColorBrush x:Key="Warn" Color="#946100"/>
      <SolidColorBrush x:Key="GoodBg" Color="#E8F5ED"/>
      <SolidColorBrush x:Key="Good" Color="#12704E"/>
      <SolidColorBrush x:Key="TextPrimary" Color="#162F43"/>
      <SolidColorBrush x:Key="TextMuted" Color="#5C6F80"/>
      <SolidColorBrush x:Key="TextNav" Color="#B9CBD9"/>
      <SolidColorBrush x:Key="Line" Color="#DCE4EC"/>

      <BooleanToVisibilityConverter x:Key="BoolToVis"/>
      <infra:InverseBoolConverter x:Key="InverseBool"/>
      <infra:InverseBoolToVisibilityConverter x:Key="InverseBoolToVis"/>
      <infra:NullToVisibilityConverter x:Key="NullToVis"/>
      <infra:StatusToBrushConverter x:Key="StatusToBrush"/>

      <Style TargetType="TextBlock">
        <Setter Property="FontFamily" Value="Segoe UI"/>
        <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
      </Style>
      <Style x:Key="H1" TargetType="TextBlock">
        <Setter Property="FontSize" Value="22"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Margin" Value="0,0,0,4"/>
      </Style>
      <Style x:Key="Lead" TargetType="TextBlock">
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Foreground" Value="{StaticResource TextMuted}"/>
        <Setter Property="Margin" Value="0,0,0,14"/>
      </Style>
      <Style x:Key="H2" TargetType="TextBlock">
        <Setter Property="FontSize" Value="15"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Margin" Value="0,14,0,6"/>
      </Style>
      <Style x:Key="Muted" TargetType="TextBlock">
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Foreground" Value="{StaticResource TextMuted}"/>
      </Style>
      <Style x:Key="Mono" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="Consolas"/>
        <Setter Property="FontSize" Value="12"/>
      </Style>
      <Style TargetType="Button">
        <Setter Property="Padding" Value="14,7"/>
        <Setter Property="Margin" Value="0,0,8,8"/>
        <Setter Property="Background" Value="{StaticResource Accent}"/>
        <Setter Property="Foreground" Value="White"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="MinHeight" Value="32"/>
        <Style.Triggers>
          <Trigger Property="IsEnabled" Value="False">
            <Setter Property="Opacity" Value="0.45"/>
          </Trigger>
        </Style.Triggers>
      </Style>
      <Style x:Key="SecondaryButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
        <Setter Property="Background" Value="#4A5664"/>
      </Style>
      <Style x:Key="DangerButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
        <Setter Property="Background" Value="{StaticResource Danger}"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
      </Style>
      <Style TargetType="TextBox">
        <Setter Property="Padding" Value="8,6"/>
        <Setter Property="Margin" Value="0,0,0,10"/>
        <Setter Property="BorderBrush" Value="{StaticResource Line}"/>
        <Setter Property="FontSize" Value="13"/>
      </Style>
      <Style TargetType="ComboBox">
        <Setter Property="Padding" Value="8,6"/>
        <Setter Property="Margin" Value="0,0,0,10"/>
        <Setter Property="FontSize" Value="13"/>
      </Style>
      <Style TargetType="CheckBox">
        <Setter Property="Margin" Value="0,0,0,8"/>
        <Setter Property="FontSize" Value="13"/>
      </Style>
      <Style TargetType="DataGrid">
        <Setter Property="Background" Value="{StaticResource BgContent}"/>
        <Setter Property="BorderBrush" Value="{StaticResource Line}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="GridLinesVisibility" Value="Horizontal"/>
        <Setter Property="HorizontalGridLinesBrush" Value="{StaticResource Line}"/>
        <Setter Property="HeadersVisibility" Value="Column"/>
        <Setter Property="IsReadOnly" Value="True"/>
        <Setter Property="AutoGenerateColumns" Value="False"/>
        <Setter Property="CanUserAddRows" Value="False"/>
        <Setter Property="SelectionMode" Value="Single"/>
        <Setter Property="RowHeight" Value="30"/>
        <Setter Property="FontSize" Value="12"/>
      </Style>
      <Style x:Key="Panel" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource BgPanel}"/>
        <Setter Property="CornerRadius" Value="6"/>
        <Setter Property="Padding" Value="16"/>
        <Setter Property="Margin" Value="0,0,0,14"/>
      </Style>
      <Style x:Key="DangerPanel" TargetType="Border" BasedOn="{StaticResource Panel}">
        <Setter Property="Background" Value="{StaticResource DangerBg}"/>
        <Setter Property="BorderBrush" Value="{StaticResource Danger}"/>
        <Setter Property="BorderThickness" Value="1"/>
      </Style>
      <Style x:Key="WarnPanel" TargetType="Border" BasedOn="{StaticResource Panel}">
        <Setter Property="Background" Value="{StaticResource WarnBg}"/>
      </Style>
    </ResourceDictionary>
  </Application.Resources>
</Application>
