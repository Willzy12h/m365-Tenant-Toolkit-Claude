<UserControl x:Class="BDIT.TenantToolkit.App.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <ScrollViewer VerticalScrollBarVisibility="Auto">
    <StackPanel Margin="24">
      <TextBlock Text="Settings and diagnostics" Style="{StaticResource H1}"/>
      <TextBlock Style="{StaticResource Lead}" Text="Everything the toolkit reads or writes lives under one portable folder. No registry, service, scheduled task or machine-wide change is made."/>
      <TextBox Text="{Binding Text, Mode=OneWay}" IsReadOnly="True" FontFamily="Consolas" FontSize="12" TextWrapping="Wrap" BorderThickness="0" Background="{StaticResource BgPanel}" Padding="14"/>
      <WrapPanel Margin="0,14,0,0">
        <Button Content="Open reports folder" Command="{Binding OpenReportsCommand}" Style="{StaticResource SecondaryButton}"/>
        <Button Content="Open evidence folder" Command="{Binding OpenDataCommand}" Style="{StaticResource SecondaryButton}"/>
        <Button Content="Open logs folder" Command="{Binding OpenLogsCommand}" Style="{StaticResource SecondaryButton}"/>
        <Button Content="Open config folder" Command="{Binding OpenConfigCommand}" Style="{StaticResource SecondaryButton}"/>
        <Button Content="Open standards folder" Command="{Binding OpenStandardsCommand}" Style="{StaticResource SecondaryButton}"/>
      </WrapPanel>
    </StackPanel>
  </ScrollViewer>
</UserControl>
