<UserControl x:Class="BDIT.TenantToolkit.App.Views.AssessmentView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Grid Margin="24">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
    </Grid.RowDefinitions>
    <StackPanel Grid.Row="0">
      <TextBlock Text="Assessment against the BDIT Build Standard" Style="{StaticResource H1}"/>
      <TextBlock Style="{StaticResource Lead}" Text="Settings are compared property by property with every object in the relevant collection. Names can differ. Unknown data is reported as unknown, never as missing."/>
      <Border Style="{StaticResource Panel}">
        <StackPanel>
          <TextBlock Text="{Binding SummaryText}"/>
          <WrapPanel Margin="0,10,0,0">
            <Button Content="Re-run assessment" Command="{Binding ReassessCommand}" Style="{StaticResource SecondaryButton}"/>
            <Button Content="Engineer report (HTML)" Command="{Binding ExportHtmlCommand}"/>
            <Button Content="Markdown" Command="{Binding ExportMarkdownCommand}" Style="{StaticResource SecondaryButton}"/>
            <Button Content="JSON" Command="{Binding ExportJsonCommand}" Style="{StaticResource SecondaryButton}"/>
            <Button Content="CSV (zip)" Command="{Binding ExportCsvCommand}" Style="{StaticResource SecondaryButton}"/>
            <Button Content="Excel" Command="{Binding ExportXlsxCommand}" Style="{StaticResource SecondaryButton}"/>
            <Button Content="Client summary (HTML)" Command="{Binding ExportClientCommand}"/>
          </WrapPanel>
          <StackPanel Orientation="Horizontal">
            <TextBox Text="{Binding LastExport, Mode=OneWay}" IsReadOnly="True" BorderThickness="0" Background="Transparent"
                     Foreground="{StaticResource TextMuted}" FontSize="12" TextWrapping="Wrap" MaxWidth="760"/>
            <Button Content="Open containing folder" Command="{Binding OpenExportCommand}" Style="{StaticResource SecondaryButton}" Margin="10,0,0,0" Padding="8,4"/>
          </StackPanel>
          <ItemsControl ItemsSource="{Binding Limitations}" Margin="0,6,0,0">
            <ItemsControl.ItemTemplate>
              <DataTemplate><TextBlock Text="{Binding}" Foreground="{StaticResource Warn}" FontSize="12"/></DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
      </Border>
    </StackPanel>
    <Grid Grid.Row="1">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="5*"/>
        <ColumnDefinition Width="4*"/>
      </Grid.ColumnDefinitions>
      <DockPanel Grid.Column="0" Margin="0,0,14,0">
        <WrapPanel DockPanel.Dock="Top" Margin="0,0,0,6">
          <TextBlock Text="Show" VerticalAlignment="Center" Margin="0,0,6,10"/>
          <ComboBox ItemsSource="{Binding StatusFilters}" SelectedItem="{Binding FilterStatus, Mode=TwoWay}" Width="200" Margin="0,0,12,10"/>
          <TextBlock Text="Category" VerticalAlignment="Center" Margin="0,0,6,10"/>
          <ComboBox ItemsSource="{Binding CategoryFilters}" SelectedItem="{Binding FilterCategory, Mode=TwoWay}" Width="180" Margin="0,0,12,10"/>
          <TextBox Text="{Binding Search, UpdateSourceTrigger=PropertyChanged}" Width="180"/>
        </WrapPanel>
        <DataGrid ItemsSource="{Binding Findings}" SelectedItem="{Binding Selected, Mode=TwoWay}">
          <DataGrid.RowStyle>
            <Style TargetType="DataGridRow">
              <Setter Property="Background" Value="{Binding StatusKey, Converter={StaticResource StatusToBrush}}"/>
            </Style>
          </DataGrid.RowStyle>
          <DataGrid.Columns>
            <DataGridTextColumn Header="Severity" Binding="{Binding Severity}" Width="80"/>
            <DataGridTextColumn Header="Control" Binding="{Binding ControlId}" Width="100"/>
            <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="200"/>
            <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="170"/>
            <DataGridTextColumn Header="Best match" Binding="{Binding BestMatch}" Width="*"/>
          </DataGrid.Columns>
        </DataGrid>
      </DockPanel>
      <DockPanel Grid.Column="1">
        <TextBox DockPanel.Dock="Top" Text="{Binding SelectedDetail, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" BorderThickness="0" Background="{StaticResource BgPanel}" Padding="10" MaxHeight="320" VerticalScrollBarVisibility="Auto" FontFamily="Consolas"/>
        <Button DockPanel.Dock="Top" Content="Copy finding detail" Command="{Binding CopyDetailCommand}" Style="{StaticResource SecondaryButton}" HorizontalAlignment="Left" Padding="8,4" Margin="10,0,0,6"/>
        <ItemsControl DockPanel.Dock="Top" ItemsSource="{Binding Notes}" Margin="0,6,0,6">
          <ItemsControl.ItemTemplate>
            <DataTemplate><TextBlock Text="{Binding}" Style="{StaticResource Muted}"/></DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal">
          <TextBlock Text="Matching / overlapping object" VerticalAlignment="Center" Margin="0,0,6,10"/>
          <ComboBox ItemsSource="{Binding Candidates}" SelectedItem="{Binding SelectedCandidate, Mode=TwoWay}" DisplayMemberPath="Name" Width="300"/>
        </StackPanel>
        <TextBlock DockPanel.Dock="Top" Text="{Binding CandidateText}" Style="{StaticResource Muted}" Margin="0,0,0,6"/>
        <Expander DockPanel.Dock="Bottom" Header="Proposed candidate (resolved recipe, JSON)" Margin="0,8,0,0">
          <TextBox Text="{Binding ProposedJson, Mode=OneWay}" IsReadOnly="True" FontFamily="Consolas" FontSize="11" Height="180" VerticalScrollBarVisibility="Auto" TextWrapping="Wrap"/>
        </Expander>
        <DataGrid ItemsSource="{Binding Differences}">
          <DataGrid.Columns>
            <DataGridTextColumn Header="Setting" Binding="{Binding Setting}" Width="200"/>
            <DataGridTextColumn Header="Current" Binding="{Binding Current}" Width="*"/>
            <DataGridTextColumn Header="BDIT standard" Binding="{Binding Standard}" Width="*"/>
            <DataGridCheckBoxColumn Header="Match" Binding="{Binding Match}" Width="60"/>
          </DataGrid.Columns>
        </DataGrid>
      </DockPanel>
    </Grid>
  </Grid>
</UserControl>
