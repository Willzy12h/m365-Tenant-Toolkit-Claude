<Window x:Class="BDIT.TenantToolkit.App.Views.ConfirmTenantDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Confirm deployment" Width="720" Height="620"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize" ShowInTaskbar="False"
        Background="{StaticResource BgContent}">
  <Grid Margin="24">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>
    <TextBlock Grid.Row="0" Text="This will make real changes in the selected tenant" Style="{StaticResource H1}" Foreground="{StaticResource Danger}"/>
    <TextBlock Grid.Row="1" x:Name="SummaryText" Margin="0,0,0,10"/>
    <ListBox Grid.Row="2" x:Name="ChangeList" FontFamily="Consolas" FontSize="12" BorderBrush="{StaticResource Line}"/>
    <StackPanel Grid.Row="3" Margin="0,12,0,0">
      <TextBlock Text="Type the tenant ID exactly as shown to confirm:" FontWeight="SemiBold"/>
      <TextBlock x:Name="TenantIdText" Style="{StaticResource Mono}" Margin="0,4,0,6"/>
      <TextBox x:Name="TypedTenantIdBox" FontFamily="Consolas" TextChanged="OnTypedChanged"/>
      <TextBlock Text="No policy will be enabled or assigned. Conditional Access candidates stay disabled with the emergency accounts and the signed-in operator excluded; Intune objects stay unassigned." Style="{StaticResource Muted}"/>
    </StackPanel>
    <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
      <Button Content="Cancel" Click="OnCancel" Style="{StaticResource SecondaryButton}"/>
      <Button x:Name="DeployButton" Content="Deploy reviewed changes" Click="OnConfirm" Style="{StaticResource DangerButton}" IsEnabled="False"/>
    </StackPanel>
  </Grid>
</Window>
