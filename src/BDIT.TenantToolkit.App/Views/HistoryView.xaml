<UserControl x:Class="BDIT.TenantToolkit.App.Views.HistoryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <ScrollViewer VerticalScrollBarVisibility="Auto">
    <StackPanel Margin="24">
      <TextBlock Text="Evidence and drift" Style="{StaticResource H1}"/>
      <TextBlock Style="{StaticResource Lead}" Text="{Binding ContextText}"/>

      <TextBlock Text="Drift between two captures" Style="{StaticResource H2}"/>
      <Border Style="{StaticResource Panel}">
        <StackPanel>
          <WrapPanel>
            <TextBlock Text="Earlier capture" VerticalAlignment="Center" Margin="0,0,6,10"/>
            <ComboBox ItemsSource="{Binding Snapshots}" SelectedItem="{Binding Before, Mode=TwoWay}" DisplayMemberPath="CapturedAt" Width="230" Margin="0,0,12,10"/>
            <TextBlock Text="Later capture" VerticalAlignment="Center" Margin="0,0,6,10"/>
            <ComboBox ItemsSource="{Binding Snapshots}" SelectedItem="{Binding After, Mode=TwoWay}" DisplayMemberPath="CapturedAt" Width="230" Margin="0,0,12,10"/>
            <Button Content="Compare" Command="{Binding CompareCommand}"/>
            <Button Content="Open earlier capture (offline)" Command="{Binding OpenSnapshotCommand}" Style="{StaticResource SecondaryButton}"/>
            <Button Content="Refresh lists" Command="{Binding RefreshCommand}" Style="{StaticResource SecondaryButton}"/>
          </WrapPanel>
          <TextBlock Text="{Binding DriftText}"/>
          <WrapPanel Margin="0,8,0,0">
            <Button Content="Export drift (HTML)" Command="{Binding ExportDriftHtmlCommand}" Style="{StaticResource SecondaryButton}"/>
            <Button Content="Markdown" Command="{Binding ExportDriftMarkdownCommand}" Style="{StaticResource SecondaryButton}"/>
            <Button Content="Excel" Command="{Binding ExportDriftXlsxCommand}" Style="{StaticResource SecondaryButton}"/>
          </WrapPanel>
          <TextBlock Text="{Binding LastExport}" Style="{StaticResource Muted}"/>
        </StackPanel>
      </Border>
      <TextBlock Text="Control status changes" Style="{StaticResource Muted}"/>
      <DataGrid ItemsSource="{Binding ControlChanges}" MaxHeight="220" Margin="0,4,0,10">
        <DataGrid.Columns>
          <DataGridTextColumn Header="Control" Binding="{Binding ControlId}" Width="100"/>
          <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="200"/>
          <DataGridTextColumn Header="Before" Binding="{Binding Before}" Width="170"/>
          <DataGridTextColumn Header="After" Binding="{Binding After}" Width="170"/>
          <DataGridCheckBoxColumn Header="Regression" Binding="{Binding Regression}" Width="80"/>
          <DataGridTextColumn Header="Explanation" Binding="{Binding Explanation}" Width="*"/>
        </DataGrid.Columns>
      </DataGrid>
      <TextBlock Text="Object changes" Style="{StaticResource Muted}"/>
      <Grid Margin="0,4,0,10">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <DataGrid Grid.Column="0" ItemsSource="{Binding DriftItems}" SelectedItem="{Binding SelectedDriftItem, Mode=TwoWay}" MaxHeight="260" Margin="0,0,8,0">
          <DataGrid.Columns>
            <DataGridTextColumn Header="Collection" Binding="{Binding CollectionLabel}" Width="150"/>
            <DataGridTextColumn Header="Object" Binding="{Binding Name}" Width="180"/>
            <DataGridTextColumn Header="Change" Binding="{Binding Change}" Width="80"/>
            <DataGridTextColumn Header="Classification" Binding="{Binding Classification}" Width="200"/>
            <DataGridCheckBoxColumn Header="Toolkit" Binding="{Binding ToolkitManaged}" Width="60"/>
          </DataGrid.Columns>
        </DataGrid>
        <DataGrid Grid.Column="1" ItemsSource="{Binding DriftDifferences}" MaxHeight="260">
          <DataGrid.Columns>
            <DataGridTextColumn Header="Setting" Binding="{Binding Setting}" Width="180"/>
            <DataGridTextColumn Header="Before" Binding="{Binding Standard}" Width="*"/>
            <DataGridTextColumn Header="After" Binding="{Binding Current}" Width="*"/>
          </DataGrid.Columns>
        </DataGrid>
      </Grid>

      <TextBlock Text="Deployment runs" Style="{StaticResource H2}"/>
      <DataGrid ItemsSource="{Binding Runs}" SelectedItem="{Binding SelectedRun, Mode=TwoWay}" MaxHeight="200" Margin="0,0,0,8">
        <DataGrid.RowStyle>
          <Style TargetType="DataGridRow">
            <Setter Property="Background" Value="{Binding Status, Converter={StaticResource StatusToBrush}}"/>
          </Style>
        </DataGrid.RowStyle>
        <DataGrid.Columns>
          <DataGridTextColumn Header="Started" Binding="{Binding StartedAt}" Width="170"/>
          <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="130"/>
          <DataGridTextColumn Header="Standard" Binding="{Binding Release}" Width="90"/>
          <DataGridTextColumn Header="Actor" Binding="{Binding Actor.Account}" Width="200"/>
          <DataGridTextColumn Header="Run ID" Binding="{Binding Id}" Width="*"/>
        </DataGrid.Columns>
      </DataGrid>
      <TextBlock Text="{Binding RunText}" Margin="0,0,0,6"/>
      <WrapPanel>
        <Button Content="Export run (HTML)" Command="{Binding ExportRunHtmlCommand}" Style="{StaticResource SecondaryButton}"/>
        <Button Content="JSON" Command="{Binding ExportRunJsonCommand}" Style="{StaticResource SecondaryButton}"/>
        <Button Content="Excel" Command="{Binding ExportRunXlsxCommand}" Style="{StaticResource SecondaryButton}"/>
      </WrapPanel>
      <DataGrid ItemsSource="{Binding RunResults}" MaxHeight="220" Margin="0,0,0,8">
        <DataGrid.Columns>
          <DataGridTextColumn Header="Control" Binding="{Binding ControlId}" Width="100"/>
          <DataGridTextColumn Header="Planned" Binding="{Binding PlannedAction}" Width="90"/>
          <DataGridTextColumn Header="Outcome" Binding="{Binding Status}" Width="100"/>
          <DataGridTextColumn Header="Object ID" Binding="{Binding ObjectId}" Width="260"/>
          <DataGridTextColumn Header="Readback" Binding="{Binding Configuration}" Width="90"/>
          <DataGridTextColumn Header="Reason" Binding="{Binding Reason}" Width="*"/>
        </DataGrid.Columns>
      </DataGrid>
      <TextBlock Text="Journal" Style="{StaticResource Muted}"/>
      <ListBox ItemsSource="{Binding Journal}" MaxHeight="220" FontFamily="Consolas" FontSize="11">
        <ListBox.ItemTemplate>
          <DataTemplate>
            <TextBlock TextWrapping="Wrap">
              <Run Text="{Binding At, Mode=OneWay}"/> <Run Text="{Binding Level, Mode=OneWay}"/> <Run Text="{Binding Message, Mode=OneWay}"/>
            </TextBlock>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>
    </StackPanel>
  </ScrollViewer>
</UserControl>
