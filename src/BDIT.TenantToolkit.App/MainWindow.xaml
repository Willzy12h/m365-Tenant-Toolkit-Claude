<Window x:Class="BDIT.TenantToolkit.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:BDIT.TenantToolkit.App.ViewModels"
        xmlns:views="clr-namespace:BDIT.TenantToolkit.App.Views"
        Title="{Binding WindowTitle}"
        Height="900" Width="1400" MinHeight="700" MinWidth="1100"
        Background="{StaticResource BgWindow}"
        WindowStartupLocation="CenterScreen"
        Closing="OnClosing">
  <Window.Resources>
    <DataTemplate DataType="{x:Type vm:ConnectViewModel}"><views:ConnectView/></DataTemplate>
    <DataTemplate DataType="{x:Type vm:ConfigurationViewModel}"><views:ConfigurationView/></DataTemplate>
    <DataTemplate DataType="{x:Type vm:AssessmentViewModel}"><views:AssessmentView/></DataTemplate>
    <DataTemplate DataType="{x:Type vm:DeviationsViewModel}"><views:DeviationsView/></DataTemplate>
    <DataTemplate DataType="{x:Type vm:PlanViewModel}"><views:PlanView/></DataTemplate>
    <DataTemplate DataType="{x:Type vm:DeployViewModel}"><views:DeployView/></DataTemplate>
    <DataTemplate DataType="{x:Type vm:HistoryViewModel}"><views:HistoryView/></DataTemplate>
    <DataTemplate DataType="{x:Type vm:ManualChecksViewModel}"><views:ManualChecksView/></DataTemplate>
    <DataTemplate DataType="{x:Type vm:StandardViewModel}"><views:StandardView/></DataTemplate>
    <DataTemplate DataType="{x:Type vm:SettingsViewModel}"><views:SettingsView/></DataTemplate>
  </Window.Resources>
  <Grid>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="270"/>
      <ColumnDefinition Width="*"/>
    </Grid.ColumnDefinitions>

    <!-- Navigation and tenant identity -->
    <DockPanel Grid.Column="0" Background="{StaticResource BgNav}">
      <Border DockPanel.Dock="Top" Background="{StaticResource BgNavHeader}" Padding="16,14">
        <StackPanel>
          <TextBlock Text="{Binding ProductName}" Foreground="#7BDDF7" FontSize="11" FontWeight="SemiBold"/>
          <TextBlock Text="{Binding TenantTitle}" Foreground="White" FontWeight="SemiBold" FontSize="15" Margin="0,8,0,0"/>
          <TextBlock Text="{Binding TenantSubtitle}" Foreground="{StaticResource TextNav}" FontSize="11" Margin="0,2,0,0"/>
          <Border Margin="0,10,0,0" Padding="8,4" CornerRadius="4" HorizontalAlignment="Left">
            <Border.Style>
              <Style TargetType="Border">
                <Setter Property="Background" Value="#2A3442"/>
                <Style.Triggers>
                  <DataTrigger Binding="{Binding IsDeploymentSession}" Value="True">
                    <Setter Property="Background" Value="{StaticResource Danger}"/>
                  </DataTrigger>
                  <DataTrigger Binding="{Binding IsAssessmentSession}" Value="True">
                    <Setter Property="Background" Value="#1F5F8B"/>
                  </DataTrigger>
                </Style.Triggers>
              </Style>
            </Border.Style>
            <TextBlock Text="{Binding ModeBadge}" Foreground="White" FontSize="11" FontWeight="SemiBold"/>
          </Border>
          <Expander Header="Connection details" Foreground="{StaticResource TextNav}" Margin="0,10,0,0" FontSize="11">
            <StackPanel Margin="0,6,0,0">
              <!-- Read-only TextBox rather than TextBlock so the engineer can select and copy individual values. -->
              <TextBox Text="{Binding DetailsText, Mode=OneWay}" IsReadOnly="True" BorderThickness="0" Background="Transparent"
                       Foreground="{StaticResource TextNav}" FontSize="11" FontFamily="Consolas" TextWrapping="Wrap"
                       HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto" MaxHeight="320"/>
              <Button Content="Copy connection details" Command="{Binding CopyDetailsCommand}" Style="{StaticResource SecondaryButton}"
                      Margin="0,6,0,0" Padding="8,4" FontSize="11" HorizontalAlignment="Left"/>
            </StackPanel>
          </Expander>
          <Button Content="Disconnect tenant" Command="{Binding DisconnectCommand}" Style="{StaticResource SecondaryButton}" Margin="0,12,0,0" Padding="10,5" FontSize="12"
                  Visibility="{Binding IsConnected, Converter={StaticResource BoolToVis}}"/>
        </StackPanel>
      </Border>
      <Border DockPanel.Dock="Bottom" Padding="16,10" Background="{StaticResource BgNavHeader}">
        <StackPanel>
          <TextBlock Text="{Binding StandardText}" Foreground="#99AFC1" FontSize="10"/>
          <TextBlock Text="{Binding VersionText}" Foreground="#7A8BA1" FontSize="10" Margin="0,3,0,0"/>
        </StackPanel>
      </Border>
      <ScrollViewer VerticalScrollBarVisibility="Auto">
        <ItemsControl ItemsSource="{Binding NavItems}" Margin="0,10,0,10">
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <Button Command="{Binding DataContext.NavigateCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                      CommandParameter="{Binding}" HorizontalContentAlignment="Left" HorizontalAlignment="Stretch"
                      BorderThickness="0" Padding="18,9" Margin="8,1" Cursor="Hand">
                <Button.Style>
                  <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                    <Setter Property="Background" Value="Transparent"/>
                    <Style.Triggers>
                      <DataTrigger Binding="{Binding IsActive}" Value="True">
                        <Setter Property="Background" Value="#204760"/>
                      </DataTrigger>
                    </Style.Triggers>
                  </Style>
                </Button.Style>
                <StackPanel Orientation="Horizontal">
                  <TextBlock Text="{Binding Step}" Foreground="#7BDDF7" FontSize="11" Width="26" VerticalAlignment="Center"/>
                  <TextBlock Text="{Binding Title}" Foreground="{StaticResource TextNav}" FontSize="13"/>
                </StackPanel>
              </Button>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </ScrollViewer>
    </DockPanel>

    <!-- Content -->
    <DockPanel Grid.Column="1">
      <Border DockPanel.Dock="Top" Background="{StaticResource DangerBg}" BorderBrush="{StaticResource Danger}" BorderThickness="0,0,0,1" Padding="16,10"
              Visibility="{Binding HasError, Converter={StaticResource BoolToVis}}">
        <DockPanel>
          <Button DockPanel.Dock="Right" Content="Dismiss" Command="{Binding ClearErrorCommand}" Style="{StaticResource SecondaryButton}" Margin="12,0,0,0" Padding="10,4"/>
          <TextBlock Text="{Binding ErrorMessage}" Foreground="{StaticResource Danger}" FontWeight="SemiBold" VerticalAlignment="Center"/>
        </DockPanel>
      </Border>
      <Border DockPanel.Dock="Top" Background="#EAF4F9" BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1" Padding="16,8"
              Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}">
        <DockPanel>
          <ProgressBar DockPanel.Dock="Left" IsIndeterminate="True" Width="90" Height="8" VerticalAlignment="Center" Margin="0,0,14,0"/>
          <StackPanel>
            <TextBlock Text="{Binding BusyMessage}" FontWeight="SemiBold"/>
            <TextBlock Text="{Binding ProgressDetail}" Style="{StaticResource Muted}"/>
          </StackPanel>
        </DockPanel>
      </Border>
      <Expander DockPanel.Dock="Bottom" Header="Activity log" Background="{StaticResource BgContent}" BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0" Padding="12,6" IsExpanded="False">
        <ListBox ItemsSource="{Binding Activity}" Height="180" FontFamily="Consolas" FontSize="11" BorderThickness="0">
          <ListBox.ItemTemplate>
            <DataTemplate>
              <TextBlock TextWrapping="NoWrap">
                <Run Text="{Binding At, Mode=OneWay}"/> <Run Text="{Binding Level, Mode=OneWay}"/> <Run Text="{Binding Category, Mode=OneWay}"/>: <Run Text="{Binding Message, Mode=OneWay}"/>
              </TextBlock>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
      </Expander>
      <Border Background="{StaticResource BgContent}">
        <ContentControl Content="{Binding CurrentPage}"/>
      </Border>
    </DockPanel>
  </Grid>
</Window>
