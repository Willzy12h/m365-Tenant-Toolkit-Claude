<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <AssemblyName>BDIT.TenantToolkit.Graph</AssemblyName>
    <RootNamespace>BDIT.TenantToolkit.Graph</RootNamespace>
    <Description>MSAL authentication, protected token cache and the guarded Microsoft Graph client.</Description>
    <!-- DPAPI token-cache protection is Windows-only by design; the toolkit is a Windows tool. -->
    <SupportedOSPlatform>windows</SupportedOSPlatform>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Identity.Client" Version="4.89.0" />
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="8.0.0" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\BDIT.TenantToolkit.Core\BDIT.TenantToolkit.Core.csproj" />
  </ItemGroup>
</Project>
